// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id         String   @id @default(uuid())
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Multitenancy: Org's DB connection info
  dbName           String
  dbHost           String
  dbUser           String
  dbPassword       String
  dbPort           Int?
  dbSchema         String?
  plan_id          String
  plans            Plans              @relation(fields: [plan_id], references: [id])
  slug             String?
  url              String?
  country          String?
  admins           AdminUser[]
  sdkConfigs       SDKConfig[]
  apiKeys          APIKey[]
  sessions         UserSession[]
  detectionHistory DetectionHistory[]
}

// 2. AdminUser
model AdminUser {
  id            String       @id @default(uuid())
  org_id        String
  email         String       @unique
  password_hash String
  salt          String
  role          String // owner, admin, viewer
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt
  organization  Organization @relation(fields: [org_id], references: [id])
}

// 3. SDKConfig
model SDKConfig {
  id           String       @id @default(uuid())
  org_id       String
  config_json  Json
  is_active    Boolean      @default(false)
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt
  organization Organization @relation(fields: [org_id], references: [id])
}

// 4. APIKey
model APIKey {
  id           String       @id @default(uuid())
  org_id       String
  key          String       @unique
  created_at   DateTime     @default(now())
  last_used_at DateTime?
  expiresAt    DateTime
  revoked      Boolean      @default(false)
  organization Organization @relation(fields: [org_id], references: [id])
}

// 5. UserSession
model UserSession {
  id             String       @id @default(uuid())
  org_id         String
  user_id        String
  session_id     String
  consent_status Json
  last_updated   DateTime     @updatedAt
  organization   Organization @relation(fields: [org_id], references: [id])
}

model Plans {
  id           String         @id @default(uuid())
  name         String
  price        Int
  features     Json
  Organization Organization[]
}

model TrackerEntity {
  id          String   @id @default(uuid())
  name        String // "Google LLC", "Facebook, Inc.", etc.
  displayName String? // e.g., "Google"
  aliases     String[] // Array of alternative names
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  properties           TrackerProperty[] // one-to-many: domains/properties owned
  trakerPrevalance     TrackerPrevalence[]
  conceptScriptPattern ConsentScriptPattern[]
}

model TrackerProperty {
  id                      String                  @id @default(uuid())
  domain                  String // e.g., "doubleclick.net"
  entityId                String
  updatedAt               DateTime                @updatedAt
  createdAt               DateTime                @default(now())
  entity                  TrackerEntity           @relation(fields: [entityId], references: [id])
  customerPurposeOverride CustomPurposeOverride[]
}

model TrackerPrevalence {
  id         String         @id @default(uuid())
  domain     String // e.g., "googletagmanager.com"
  entityId   String?
  prevalence Float // % or count (from your dataset)
  cookies    Float? // Number or rate of cookies set
  fp         Float? // Fingerprinting metric
  source     String? // Data origin (Disconnect, etc.)
  updatedAt  DateTime       @updatedAt
  createdAt  DateTime       @default(now())
  entity     TrackerEntity? @relation(fields: [entityId], references: [id])
}

model CustomPurposeOverride {
  id         String   @id @default(uuid())
  orgId      String // Organization using the override
  propertyId String // FK to TrackerProperty
  purpose    String // e.g., "Marketing", "Analytics", "Necessary"
  notes      String? // Admin comment or justification
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  property TrackerProperty @relation(fields: [propertyId], references: [id])
}

model DetectionHistory {
  id               String               @id @default(uuid())
  orgId            String // Org/website scanned
  detectedAt       DateTime // Scan timestamp
  domain           String // Domain/page scanned
  matchedPatternId String // FK to ConsentScriptPattern
  detectedBy       String? // "crawler", "manual", etc.
  rawEvidence      String? // e.g., full script src or snippet
  createdAt        DateTime             @default(now())
  organisation     Organization         @relation(fields: [orgId], references: [id])
  pattern          ConsentScriptPattern @relation(fields: [matchedPatternId], references: [id])
}

model FingerprintingMethod {
  id         String  @id @default(uuid())
  name       String // e.g., "Navigator.prototype.userAgent"
  prevalence Float // How often it's used (from your dataset)
  riskScore  Float // Custom risk score if you want
  notes      String? // Additional context or explanation
}

model ConsentScriptPattern {
  id               String             @id @default(uuid())
  pattern          String // Regex or URL pattern (e.g., "^https?://(www\\.)?googletagmanager\\.com/gtm\\.js")
  category         String // e.g., "Analytics", "Advertising", "Fingerprinting"
  entityId         String? // FK to TrackerEntity (optional, for linking)
  source           String? // Dataset or project origin, e.g., "Disconnect", "DuckDuckGo", "Mozilla"
  updatedAt        DateTime           @updatedAt
  createdAt        DateTime           @default(now())
  detectionHistory DetectionHistory[]
  entity           TrackerEntity?     @relation(fields: [entityId], references: [id])
}

model ClonedRepo {
  id           String   @id @default(ulid())
  url          String
  name         String
  addsAt       DateTime
  lastCommitId String
  active       Boolean
}
