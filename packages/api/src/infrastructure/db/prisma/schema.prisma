// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id         String   @id @default(uuid())
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Multitenancy: Org's DB connection info
  dbName           String
  dbHost           String
  dbUser           String
  dbPassword       String
  dbPort           Int?
  dbSchema         String?
  plan_id          String
  plans            Plans              @relation(fields: [plan_id], references: [id])
  slug             String?
  url              String?
  country          String?
  admins           AdminUser[]
  sdkConfigs       SDKConfig[]
  apiKeys          APIKey[]
  sessions         UserSession[]
}

model AdminUser {
  id            String       @id @default(uuid())
  org_id        String
  email         String       @unique
  password_hash String
  salt          String
  role          String // owner, admin, viewer
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt
  organization  Organization @relation(fields: [org_id], references: [id])
}

model SDKConfig {
  id           String       @id @default(uuid())
  org_id       String
  config_json  Json
  is_active    Boolean      @default(false)
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt
  organization Organization @relation(fields: [org_id], references: [id])
}

model APIKey {
  id           String       @id @default(uuid())
  org_id       String
  key          String       @unique
  created_at   DateTime     @default(now())
  last_used_at DateTime?
  expiresAt    DateTime
  revoked      Boolean      @default(false)
  organization Organization @relation(fields: [org_id], references: [id])
}

model UserSession {
  id             String       @id @default(uuid())
  org_id         String
  user_id        String
  session_id     String
  consent_status Json
  last_updated   DateTime     @updatedAt
  organization   Organization @relation(fields: [org_id], references: [id])
}

model Plans {
  id           String         @id @default(uuid())
  name         String
  price        Int
  features     Json
  Organization Organization[]
}


model Entity {
  id            Int      @id @default(autoincrement())
  name          String
  displayName   String?
  url           String?
  privacyPolicy String?
  prevalence    Float?
  properties    String[] // domains owned by this entity

  // Relations
  domains       Domain[]
}

model Domain {
  id             Int        @id @default(autoincrement())
  domain         String     @unique
  prevalence     Float?
  cookies        Float?
  fingerprinting Int?       // 0-3
  performance    Json?      // { cache, time, size, cpu }
  categories     String[]
  types          String[]
  cnames         String[]
  nameservers    String[]
  ownerId        Int?
  owner          Entity?    @relation(fields: [ownerId], references: [id])

  // Relations
  resources      Resource[]
}

model Resource {
  id                 Int      @id @default(autoincrement())
  domainId           Int
  rule               String
  cookies            Float?
  fingerprinting     Int?
  apis               String[]
  prevalence         Float?
  cnames             String[]
  exampleSites       String[]
  firstPartyCookies  Json?
  firstPartyCookiesSent Json?

  // Relations
  domain             Domain   @relation(fields: [domainId], references: [id])
}

model TrackingParameter {
  paramName      String   @id
  prevalence     Float?
  requests3p     Json?    // { prevalence, entities, domains }
  cookies        Json?    // { prevalence, firstParty, thirdParty, entities, domains }
  exampleSites   String[]
}

model BreakageRule {
  id          Int      @id @default(autoincrement())
  rule        String
  domains     String[]
  types       String[]
  reason      Json?
}

model ClonedRepo {
  id           String   @id @default(ulid())
  url          String
  name         String
  addsAt       DateTime
  lastCommitId String
  active       Boolean
}
